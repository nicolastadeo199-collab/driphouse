# Base de datos (SQLite local). En produccion sobre un host con disco persistente
# dejar esta ruta apuntando a un archivo dentro de ese disco (ver README).
DATABASE_URL="file:./dev.db"

# Credenciales del panel de administracion (unico usuario admin).
ADMIN_EMAIL="admin@driphouse.com"
ADMIN_PASSWORD="cambiar-esta-clave"

# Secret para firmar las sesiones de NextAuth. Generar uno con:
# openssl rand -base64 32
AUTH_SECRET="reemplazar-por-un-secreto-largo-y-random"

# Numero de WhatsApp de contacto, en formato internacional sin signos (ej: 5491122334455)
NEXT_PUBLIC_WHATSAPP_NUMBER="5491100000000"

# Usuario de Instagram (sin @)
NEXT_PUBLIC_INSTAGRAM_USER="driphouse_store_"

# Carpeta donde se guardan las imagenes subidas desde el admin.
# En local puede quedar así. En produccion, apuntar a la carpeta del disco persistente.
UPLOAD_DIR="./public/uploads"

# URL publica del sitio ya deployado (sin barra final), usada en metadata Open Graph
# y en el JSON-LD de cada producto para SEO. Dejar vacío en local.
NEXT_PUBLIC_SITE_URL=""
